    <!-- ============ HARDWARE FEATURES ============ -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!-- ============ APPLICATION ============ -->
    <application
        android:name="com.tech.ayugram.ApplicationLoader"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        tools:replace="android:allowBackup,android:fullBackupContent,android:icon,android:label,android:roundIcon,android:supportsRtl,android:theme,android:usesCleartextTraffic,android:networkSecurityConfig,android:largeHeap,android:hardwareAccelerated">

        <!-- Provider for FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.tech.ayugram.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Room Database Auto-migration -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.tech.ayugram.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.room.RoomInitializer"
                android:value="androidx.room.RoomInitializer" />
        </provider>

        <!-- ============ ACTIVITIES ============ -->
        
        <!-- Launch Activity -->
        <activity
            android:name="com.tech.ayugram.ui.LaunchActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tg" />
            </intent-filter>
        </activity>

        <!-- Main Dialogs Activity -->
        <activity
            android:name="com.tech.ayugram.ui.DialogsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Chat Activity -->
        <activity
            android:name="com.tech.ayugram.ui.ChatActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize" />

        <!-- Profile Activity -->
        <activity
            android:name="com.tech.ayugram.ui.ProfileActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Settings Activity -->
        <activity
            android:name="com.tech.ayugram.ui.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- AyuGram Preferences Activity -->
        <activity
            android:name="com.tech.ayugram.ui.AyuGramPreferencesActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- ============ SERVICES (Kept per PLAN.md §6) ============ -->
        
        <!-- Notifications Service -->
        <service
            android:name="com.tech.ayugram.messenger.NotificationsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- VoIP Service -->
        <service
            android:name="com.tech.ayugram.messenger.VoIPService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback|mediaProjection" />

        <!-- Telegram Connection Service -->
        <service
            android:name="com.tech.ayugram.messenger.TelegramConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keep Alive Job -->
        <service
            android:name="com.tech.ayugram.messenger.KeepAliveJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Bring App Foreground Service -->
        <service
            android:name="com.tech.ayugram.messenger.BringAppForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notification Repeat Service -->
        <service
            android:name="com.tech.ayugram.messenger.NotificationRepeat"
            android:exported="false" />

        <!-- Video Encoding Service (for round videos) -->
        <service
            android:name="com.tech.ayugram.messenger.VideoEncodingService"
            android:exported="false" />

        <!-- Importing Service -->
        <service
            android:name="com.tech.ayugram.messenger.ImportingService"
            android:exported="false" />

        <!-- Music Player Service -->
        <service
            android:name="com.tech.ayugram.messenger.MusicPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Music Browser Service -->
        <service
            android:name="com.tech.ayugram.messenger.MusicBrowserService"
            android:exported="false" />

        <!-- Widget Services (3) -->
        <service
            android:name="com.tech.ayugram.messenger.widget.WidgetService1"
            android:exported="false" />
        <service
            android:name="com.tech.ayugram.messenger.widget.WidgetService2"
            android:exported="false" />
        <service
            android:name="com.tech.ayugram.messenger.widget.WidgetService3"
            android:exported="false" />

        <!-- Files Migration Service -->
        <service
            android:name="com.tech.ayugram.messenger.FilesMigrationService"
            android:exported="false" />

        <!-- ============ RECEIVERS (Kept per PLAN.md §6) ============ -->
        
        <!-- SMS Receiver (for login codes) -->
        <receiver
            android:name="com.tech.ayugram.messenger.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Call Receiver -->
        <receiver
            android:name="com.tech.ayugram.messenger.CallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- ============ REMOVED SERVICES/RECEIVERS (per PLAN.md §6) ============ -->
        <!--
        <service android:name="...StoryUploadingService" />                    <!-- R19: REMOVED -->
        <service android:name="...TelegramCarAppService" />                    <!-- R20: REMOVED -->
        <service android:name="...WearAuthListenerService" />                  <!-- R21: REMOVED -->
        <service android:name="...AuthenticatorService" />                     <!-- R32: REMOVED -->
        <service android:name="...ContactsSyncAdapterService" />               <!-- R32: REMOVED -->
        <service android:name="...LocationSharingService" />                   <!-- R34: REMOVED -->
        <receiver android:name="...WearReplyReceiver" />                       <!-- R21: REMOVED -->
        <receiver android:name="...AppStartReceiver" />                        <!-- R32: REMOVED -->
        -->

        <!-- ============ META-DATA ============ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default_channel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_notification" />

    </application>

    <!-- ============ QUERIES (Package visibility) ============ -->
    <queries>
        <!-- Custom Tabs (R30) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- Play Store -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- Launcher shortcuts -->
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
        <!-- Emulators detector -->
        <package android:name="com.android.vending" />
    </queries>

</manifest>